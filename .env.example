# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER put real keys in this example file.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# OpenAI key from a dedicated "wedding" project (set a monthly budget limit!)
OPENAI_API_KEY=

# Optional: choose the exact chatbot model without changing code
# (default: gpt-6-luna)
OPENAI_MODEL=gpt-6-luna

# Enable only after the shared messaging backend is configured and tested.
# Leaving this blank keeps the existing website assistant active.
MESSAGING_ASSISTANT_URL=
WEB_CHAT_SERVICE_TOKEN=

# Password for /live-admin (share only with whoever runs the live updates)
LIVE_ADMIN_PASSWORD=

# Vercel: the full service-account JSON (lets /api/live-admin write to Firestore).
# Locally this can stay blank — scripts/dev-server.js loads the gitignored key file.
# FIREBASE_SERVICE_ACCOUNT=
